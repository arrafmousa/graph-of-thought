    "deployment": "gpt-5.1",
    "api_key_environment_variable": "AZURE_OPENAI_API_KEY",
    "request_url": "/v1/chat/completions",
    "batch_endpoint": "/chat/completions",
    "completion_window": "24h",
    "system_instruction": "You are a strict mathematical reasoning evaluator. Judge only whether two partial reasoning paths have inferred the same information at their endpoints. Do not use their unseen final answers. Equivalent means either path can replace the other without losing a fact, constraint, intermediate value, case distinction, or unresolved uncertainty needed for correct continuation. Return only the required JSON object.",
    "pair_prompt_template": "Question:\n{question}\n\nReasoning path A through the candidate merge:\n{path_a}\n\nReasoning path B through the candidate merge:\n{path_b}\n\nClassify endpoint equivalence. Score 0 for contradictory or unrelated states, 1 for weak topical overlap, 2 for partially aligned states with material differences, 3 for nearly equivalent states with a minor difference, and 4 for semantically interchangeable states. Set redundancy_safe true only when developing either one would make the other continuation redundant.",
    "max_completion_tokens": 2048,
    "max_score": 4,
    "parse_attempts": 2,
    "poll_interval_seconds": 60,
    "max_wait_seconds": 90000,
    "submission_attempts": 5,
    "submission_retry_seconds": 60
  },
  "quality": {
    "semantic_weight": 1.0,
    "continuation_weight": 1.0,
    "quality_beta": 1.0,
    "missing_answer_agreement_score": 0.0
  },
